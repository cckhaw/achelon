# --- Database (Neon) -----------------------------------------------------------------------------
# Runtime, tenant-scoped connection. MUST be the non-owner role `achelon_app` so Row-Level Security applies.
DATABASE_URL="postgresql://achelon_app:achelon_app@localhost:5432/achelon"
# Owner role: migrations, bootstrap, login/session lookup, cron fan-out. Bypasses RLS. Never expose to tenant code paths.
DATABASE_URL_OWNER="postgresql://achelon:achelon@localhost:5432/achelon"
# Password given to the achelon_app role by `npm run db:migrate` (must match the one embedded in DATABASE_URL).
APP_DB_PASSWORD="achelon_app"

# --- App ---------------------------------------------------------------------------------------
APP_URL="http://localhost:3000"
# 32+ random bytes, used to derive HMAC keys for rate-limit buckets and encrypt Strava tokens: openssl rand -base64 32
APP_SECRET="generate-with-openssl-rand-base64-32"
# Bearer token for /api/cron/* (Vercel Cron sends it automatically when CRON_SECRET is set): openssl rand -hex 24
CRON_SECRET="generate-with-openssl-rand-hex-24"

# --- Email (Resend). Unset = emails are logged to the console (development). ---------------------
RESEND_API_KEY=""
MAIL_FROM="Achelon <noreply@khaw.cc>"

# --- Strava: off | mock | live -----------------------------------------------------------------
STRAVA_MODE="mock"
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
# STRAVA_API_BASE_URL=""

# --- First community (used by `npm run db:bootstrap`) -----------------------------------------
BOOTSTRAP_TENANT_SLUG="een"
BOOTSTRAP_TENANT_NAME="Executive Endurance Network"
BOOTSTRAP_OWNER_EMAIL=""
